# Database
# Use PostgreSQL for shared/deployed environments.
DATABASE_URL=postgresql://username:password@localhost:5432/castlink
# Optional local SQLite fallback used by the application default.
DATABASE_LOCAL_URL=sqlite:///./chroma_db/local_talent.db

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.1

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Application URLs
BASE_URL=http://localhost:3000
BASE_URL_BACKEND=http://localhost:8008

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
